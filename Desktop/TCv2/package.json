{
  "name": "thecrumb-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Crumb — link-in-bio platform (restructured TCv2 architecture)",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --port=9090 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "start": "npm run start:server",
    "start:server": "node dist-server/server/index.js",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('dist-server', { recursive: true, force: true });\"",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "vercel-build": "npm run build:server && npm run build",
    "db:optimize": "tsx scripts/admin/optimize-database.ts",
    "db:test": "tsx scripts/admin/test-db-connection.ts",
    "db:check": "node scripts/check-database-collections.js",
    "db:migrate:security": "tsx migrations/migrate-security.ts",
    "db:migrate:performance": "node migrations/migrate_performance.cjs",
    "db:migrate:tracking": "node migrations/setup-realtime-tracking.cjs",
    "db:seed": "tsx server/seed.ts",
    "admin:approve-monetization": "tsx scripts/admin/approve-monetization.ts",
    "admin:check-monetization": "tsx scripts/admin/check-monetization-status.ts",
    "secrets:check": "node scripts/check-secrets.js",
    "secrets:generate": "node scripts/generate-secrets.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.1.0",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-rate-limit": "^8.4.0",
    "form-data": "^4.0.5",
    "framer-motion": "^12.38.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.6.2",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.5",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "react-simple-maps": "^1.0.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^8.0.0",
    "@vercel/node": "^5.8.5",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  }
}
