# ============================================
# SECURITY CONFIGURATION - READ CAREFULLY
# ============================================
# This file contains examples of required environment variables.
# NEVER commit your actual .env file to version control!
# See DEPLOYMENT_SECURITY_GUIDE.md for detailed instructions.

# ============================================
# CRITICAL SECURITY SECRETS
# ============================================
# Generate strong secrets with these commands:
# JWT_SECRET: openssl rand -base64 32
# JWT_REFRESH_SECRET: openssl rand -base64 32
# ENCRYPTION_KEY: openssl rand -hex 32

# IMPORTANT: Generate a strong random string for production
# Use: openssl rand -base64 32
JWT_SECRET="replace_me_with_strong_random_string"

# Refresh token secret (should be different from JWT_SECRET)
# Use: openssl rand -base64 32
JWT_REFRESH_SECRET="replace_me_with_different_strong_random_string"

# Encryption key for sensitive data (Instagram tokens, etc.)
# Use: openssl rand -hex 32
ENCRYPTION_KEY="replace_me_with_64_char_hex_string"

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Node Environment (development, production, test)
NODE_ENV="development"

# Email Service Configuration (SMTP) - Required for email verification and password reset
# For Gmail: Enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
# For SendGrid: Use "apikey" as SMTP_USER and your API key as SMTP_PASS
# For other providers: Check their SMTP documentation
EMAIL_FROM="noreply@thecrumb.co"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-here"

# Frontend URL used for backend redirects and shared links.
APP_URL="http://127.0.0.1:9090"

# Public backend URL used for upload URLs and OAuth callbacks.
API_URL="http://127.0.0.1:5000"

# Frontend-side API base used by Vite.
VITE_API_URL="http://127.0.0.1:5000"

# Optional frontend base URL override used by Vite.
VITE_APP_URL="http://127.0.0.1:9090"

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB Connection String
# Local: mongodb://localhost:27017/crumb_db
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/crumb_db?retryWrites=true&w=majority&maxPoolSize=50&minPoolSize=10
# 
# PRODUCTION SECURITY:
# - NEVER use localhost in production
# - ALWAYS use MongoDB Atlas or managed database
# - ALWAYS enable authentication
# - RESTRICT network access to known IPs
# 
# Connection Parameters Explained:
# - retryWrites=true: Automatically retry failed write operations
# - w=majority: Wait for majority of replica set nodes to acknowledge writes
# - maxPoolSize=50: Maximum number of connections in the pool
# - minPoolSize=10: Minimum number of connections to keep alive (prevents disconnections)
MONGO_URI="mongodb://localhost:27017/crumb_db"

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Required for email verification and password reset
# SMTP settings - use your email provider's SMTP server
# Gmail: smtp.gmail.com (port 587), use App Password not regular password
# SendGrid: smtp.sendgrid.net (port 587)
# Mailgun: smtp.mailgun.org (port 587)
EMAIL_FROM="noreply@thecrumb.co"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ============================================
# CLOUD STORAGE CONFIGURATION
# ============================================
# REQUIRED for Vercel/production deployment
# Without this, images will NOT persist on Vercel!
# Sign up at https://cloudinary.com/users/register_free (free tier - no credit card)
# Get credentials from: https://console.cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ============================================
# INSTAGRAM INTEGRATION (OPTIONAL)
# ============================================
# Optional Meta / Instagram integration settings.
META_APP_ID="YOUR_APP_ID"
META_APP_SECRET="YOUR_APP_SECRET"
META_VERIFY_TOKEN="crumb_meta_secret_123"
META_REDIRECT_URI="http://127.0.0.1:5000/api/auth/instagram/callback"

# Frontend needs VITE_ prefix to access env vars
VITE_META_APP_ID="YOUR_APP_ID"

# ============================================
# LOGGING CONFIGURATION (OPTIONAL)
# ============================================
# Directory for security and error logs
# Default: ./logs
# Production: /var/log/crumb or use external logging service
# LOG_DIR="/var/log/crumb"

# ============================================
# RATE LIMITING & ABUSE PROTECTION (OPTIONAL)
# ============================================
# Redis URL for distributed rate limiting (recommended for production)
# If not set, uses in-memory storage (works for single server)
# REDIS_URL="redis://localhost:6379"

# CAPTCHA Configuration (optional but recommended for production)
# Google reCAPTCHA v3: https://www.google.com/recaptcha/admin
# RECAPTCHA_SECRET_KEY="your_recaptcha_secret_key"
# VITE_RECAPTCHA_SITE_KEY="your_recaptcha_site_key"

# hCaptcha alternative: https://www.hcaptcha.com/
# HCAPTCHA_SECRET_KEY="your_hcaptcha_secret_key"
# VITE_HCAPTCHA_SITE_KEY="your_hcaptcha_site_key"
